---
interface Props {
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  type = 'button',
  class: className = '',
} = Astro.props;

const buttonClasses = [
  'font-button-text',
  'flex h-12 w-full items-center justify-center rounded-xl bg-purple-800 px-5 text-white',
  'transition hover:bg-purple-900',
  'focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200',
  'active:bg-purple-950',
  className,
].filter(Boolean).join(' ');
---

<button type={type} class={buttonClasses}>
  <slot />
</button>
