---
---

<div id="container" class="min-h-screen bg-blue-50 px-4 py-12 font-sans text-blue-950 sm:px-6">
  <main class="mx-auto flex min-h-[calc(100vh-6rem)] max-w-7xl items-center justify-center">
    <section id="login" class="w-full max-w-md rounded-3xl border border-blue-100 bg-white p-6 shadow-xl shadow-blue-950/10 sm:p-10">
      <h1 class="mb-8 text-center text-3xl font-bold tracking-tight">
        Login
      </h1>
      <form class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="block text-sm font-semibold text-blue-900">
            Email: 
			</label>
          <input 
		  	type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            class="block h-12 w-full rounded-xl border border-blue-200 bg-white px-4 text-base text-blue-950 outline-none transition placeholder:text-blue-400 hover:border-blue-400 focus:border-indigo-600 focus:ring-4 focus:ring-indigo-200"/>
        </div>

        <div class="space-y-2">
          <label for="password" class="block text-sm font-semibold text-blue-900">
            Password:
          </label>

          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            class="block h-12 w-full rounded-xl border border-blue-200 bg-white px-4 text-base text-blue-950 outline-none transition placeholder:text-blue-400 hover:border-blue-400 focus:border-indigo-600 focus:ring-4 focus:ring-indigo-200"/>
        </div>

        <button
          type="submit"
          class="flex h-12 w-full items-center justify-center rounded-xl bg-indigo-700 px-5 text-base font-semibold text-white transition hover:bg-indigo-800 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200 active:bg-indigo-900"
        >
          Login
        </button>
      </form>
    </section>
  </main>
</div>
<style>

	#login{
		display: flex;
		justify-content:flex-end;
		align-items: center;
		padding: 60px 52px;
		flex-direction: column;
		align-items: flex-start;
		gap: 36px;
	}
</style>
