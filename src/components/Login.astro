---
---

<div id="container" class="flex min-h-screen items-center justify-end px-12 py-12 font-sans text-purple-950 sm:px-6">
  <main class="flex w-full max-w-7xl justify-end">
    <section id="login" class="w-full max-w-md rounded-3xl border border-purple-100/60 bg-purple-50/85 p-6 shadow-2xl shadow-purple-950/15 backdrop-blur-sm sm:p-10">
      <h1 class="font-h1---desk mb-4 text-indigo-800">
        Login
      </h1>
      <p class="font-p---sm mb-8 text-purple-90 pr-24">
        Want to log your next dream travel destination, enter email and password
      </p>
      <form action="http://localhost:3000/login" method="POST" class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="font-h6---desk block text-purple-900">
            Email:
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            class="block h-12 w-full rounded-xl border border-purple-200 bg-purple-50 px-4 text-base text-purple-950 outline-none transition placeholder:text-purple-600 hover:border-purple-400 focus:border-indigo-600 focus:ring-4 focus:ring-indigo-200"
          />
        </div>

        <div class="space-y-2">
          <label for="password" class="font-h6---desk block text-purple-900">
            Password:
          </label>

          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            class="block h-12 w-full rounded-xl border border-purple-200 bg-purple-50 px-4 text-base text-purple-950 outline-none transition placeholder:text-purple-600 hover:border-purple-400 focus:border-indigo-600 focus:ring-4 focus:ring-indigo-200"
          />
        </div>

        <button
          type="submit"
          class="font-button-text flex h-12 w-full items-center justify-center rounded-xl bg-indigo-700 px-5 text-purple-50 transition hover:bg-indigo-800 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200 active:bg-indigo-900"
        >
          Login
        </button>
    </form>
  <div class="mt-6 flex flex-col items-center gap-1 text-center text-purple-800">
		<span class="font-p---sm">New here?</span>
    <a href="/register" class="font-p---sm font-semibold text-indigo-700 underline hover:text-indigo-900">
			Create an account
		</a>
	</div>
     
    </section>
  </main>
</div>
