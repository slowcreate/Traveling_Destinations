---
import Button from './Button.astro';
import Input from './Input.astro';
---

<div id="container" class="flex min-h-screen items-center justify-end px-58 py-12 text-blue-950 sm:px-24 xs:justify-center xl:justify-center">
  <main class="flex w-full max-w-7xl justify-end">
    <section id="login" class="card w-full max-w-md">
      <h1 class="font-h2---desk mb-2">
        Login
      </h1>
      <p class="font-p---lg mb-8 pr-4">
        Want to log your next dream travel destination, enter email and password
      </p>
      <form action="http://localhost:3000/login" method="POST" class="space-y-4">
        <div class="space-y-2">
          <!-- <label for="email" class="font-h6---desk block text-blue-950">
            Email:
          </label> -->
          <Input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            placeholder="Email:"
          />
        </div>

        <div class="space-y-2">
          <!-- <label for="password" class="font-h6---desk block text-blue-950">
            Password:
          </label> -->

          <Input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="Password:"
          />
        </div>

        <Button type="submit">
          Login
        </Button>
    </form>
  <div class="mt-6 flex flex-col items-center gap-1 text-center text-blue-800">
		<span class="font-p---sm">New here?</span>
    <a href="/register" class="font-p---sm font-semibold text-indigo-700 underline hover:text-indigo-900">
			Create an account
		</a>
	</div>
     
    </section>
  </main>
</div>
