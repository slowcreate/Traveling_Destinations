---
---

<div id="container" class="flex min-h-screen items-center justify-center px-4 py-12 font-sans text-blue-950 sm:px-6">
  <main class="flex w-full max-w-7xl justify-center">
    <section class="w-full max-w-md rounded-3xl border border-white/60 bg-white/85 p-6 shadow-2xl shadow-blue-950/15 backdrop-blur-sm sm:p-10">
      <h1 class="mb-8 text-center text-3xl font-bold tracking-tight text-blue-950">
        Create account
      </h1>
      <form action="http://localhost:3000/register" method="POST" class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="block text-sm font-semibold text-blue-900">
            Email:
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            class="block h-12 w-full rounded-xl border border-blue-200 bg-white px-4 text-base text-blue-950 outline-none transition placeholder:text-blue-400 hover:border-blue-400 focus:border-indigo-600 focus:ring-4 focus:ring-indigo-200"
          />
        </div>

        <div class="space-y-2">
          <label for="password" class="block text-sm font-semibold text-blue-900">
            Password:
          </label>
          <input
            type="password"
            id="password"
            name="password"
            minlength="12"
            autocomplete="new-password"
            required
            class="block h-12 w-full rounded-xl border border-blue-200 bg-white px-4 text-base text-blue-950 outline-none transition placeholder:text-blue-400 hover:border-blue-400 focus:border-indigo-600 focus:ring-4 focus:ring-indigo-200"
          />
          <p class="text-sm text-blue-700">Use at least 12 characters.</p>
        </div>

        <button
          type="submit"
          class="flex h-12 w-full items-center justify-center rounded-xl bg-indigo-700 px-5 text-base font-semibold text-white transition hover:bg-indigo-800 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200 active:bg-indigo-900"
        >
          Create account
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-blue-800">
        Already have an account?
        <a href="/login" class="font-semibold text-indigo-700 underline hover:text-indigo-900">Sign in</a>
      </p>
    </section>
  </main>
</div>
