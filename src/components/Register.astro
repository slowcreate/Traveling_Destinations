---
import Button from './Button.astro';
import Input from './Input.astro';
---

<div id="container" class="flex min-h-screen items-center justify-center bg-blue-50 px-4 py-12 text-blue-950 sm:px-6">
  <main class="flex w-full max-w-7xl justify-center">
    <section class="w-full max-w-md rounded-3xl border border-blue-100/60 bg-blue-50/85 p-6 shadow-2xl shadow-blue-950/15 backdrop-blur-sm sm:p-10">
      <h1 class="font-h1---desk mb-4 text-center text-blue-800">
        Create account
      </h1>
      <p class="font-p---lg mb-8 text-blue-950">
        Save your dream travel destinations in one place
      </p>
      <form action="http://localhost:3000/register" method="POST" class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="font-h6---desk block text-blue-950">
            Email:
          </label>
          <Input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            placeholder="Email:"
          />
        </div>

        <div class="space-y-2">
          <label for="password" class="font-h6---desk block text-blue-950">
            Password:
          </label>
          <Input
            type="password"
            id="password"
            name="password"
            minlength="12"
            autocomplete="new-password"
            required
            placeholder="Password:"
          />
          <p class="font-p---sm text-blue-500">Use at least 12 characters.</p>
        </div>

        <div class="space-y-2">
          <label for="confirm-password" class="font-h6---desk block text-blue-950">
            Verify password:
          </label>
          <Input
            type="password"
            id="confirm-password"
            name="confirmPassword"
            minlength="12"
            autocomplete="new-password"
            required
            placeholder="Verify password:"
          />
        </div>

        <Button type="submit">
          Create account
        </Button>
      </form>

      <p class="mt-6 flex flex-col items-center gap-1 text-center text-blue-800">
        <span class="font-p---sm">Already have an account?</span>
        <a href="/login" class="font-p---sm font-semibold text-indigo-700 underline hover:text-indigo-900">Sign in</a>
      </p>
    </section>
  </main>
</div>
